<Window x:Class="DotaHelper.HeroPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор героя Dota 2"
        Width="980" Height="665" MinWidth="760" MinHeight="520"
        Background="#101923" Foreground="#E6ECF3" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <Style x:Key="PickerBlankRepeat" TargetType="RepeatButton">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PickerScrollThumb" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body" Background="#42596E" CornerRadius="5" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#69879B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="PickerVerticalBar" TargetType="ScrollBar">
            <Border Width="9" Background="#1B2935" CornerRadius="5">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource PickerBlankRepeat}"
                                      Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource PickerScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource PickerBlankRepeat}"
                                      Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template" Value="{StaticResource PickerVerticalBar}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF2F7"/>
            <Setter Property="Background" Value="#31465A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <DataTemplate x:Key="HeroIcon">
            <Button Tag="{Binding}" Click="Hero_Click"
                    ToolTip="{Binding Hero.Name}"
                    ToolTipService.ShowOnDisabled="True"
                    Width="43" Height="53" Padding="0" Margin="2"
                    Background="#172532">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value=".42"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Border CornerRadius="4" ClipToBounds="True"
                        BorderBrush="#3F5365" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding Hero.PortraitUrl}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Grey neutral overlay only on nonmatching heroes. -->
                        <Border Background="#B45B626A"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,11">
            <TextBlock Text="ГЕРОИ" FontSize="19" FontWeight="Bold"
                       Foreground="#DDB775" VerticalAlignment="Center"/>
            <TextBlock Text="  ·  печатай имя, несовпадения станут серыми"
                       FontSize="11" Foreground="#9CB0C1"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,11">
            <TextBlock DockPanel.Dock="Right" x:Name="CounterLabel"
                       Foreground="#8DA6B7" VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
            <TextBox x:Name="SearchBox" Height="36"
                     Background="#243547" BorderBrush="#3B586C" Foreground="White"
                     CaretBrush="White" FontSize="13" Padding="9,6"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Русские и английские названия, сокращения (вд, шд, легион), раскладка клавиатуры"/>
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#101923">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#17232E" BorderBrush="#324557"
                                BorderThickness="1" CornerRadius="7"
                                Padding="7" Margin="3" MinHeight="360">
                            <StackPanel>
                                <DockPanel Margin="2,1,0,8">
                                    <TextBlock Text="{Binding Glyph}" FontSize="16"
                                               Foreground="{Binding Accent}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#A6B6C7"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Heroes}"
                                              ItemTemplate="{StaticResource HeroIcon}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Вводи сразу · RU/EN · ВД, ШД, ЛЕГИОН · Enter при одном совпадении"
                       Foreground="#7F93A5" FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Content="Отмена" Click="Cancel_Click"
                    DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <Button Content="Сбросить слот" Click="Clear_Click"
                    Background="#603E49" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>