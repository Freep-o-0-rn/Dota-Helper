<Window x:Class="DotaHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota Helper — Draft Assistant 0.11"
        Width="1520" Height="850" MinWidth="1120" MinHeight="690"
        Background="#101722" Foreground="#E9F0F5" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>
        <SolidColorBrush x:Key="Panel" Color="#1A2532"/>
        <SolidColorBrush x:Key="Muted" Color="#98AABA"/>
        <SolidColorBrush x:Key="Gold" Color="#E0B76F"/>
        <SolidColorBrush x:Key="Radiant" Color="#43C8AE"/>
        <SolidColorBrush x:Key="Dire" Color="#E26D87"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="Background" Value="#304457"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F6FA"/>
            <Setter Property="Background" Value="#253649"/>
            <Setter Property="BorderBrush" Value="#3A5064"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#E7F1F9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBorder" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBorder" Property="BorderBrush" Value="#59BDB1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6F0F7"/>
            <Setter Property="Background" Value="#26374A"/>
            <Setter Property="Padding" Value="9,7"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3B536A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#345D62"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#253649"/>
            <Setter Property="Foreground" Value="#E7F0F7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectChrome" CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#3B5166" BorderThickness="1">
                                <DockPanel Margin="9,3">
                                    <TextBlock DockPanel.Dock="Right" Text="⌄"
                                               FontSize="17" Foreground="#ADBDCE"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                </DockPanel>
                            </Border>
                            <ToggleButton Focusable="False" Background="Transparent"
                                          BorderThickness="0" Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   StaysOpen="False" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#26374A" BorderBrush="#496075"
                                        BorderThickness="1" CornerRadius="7"
                                        MinWidth="{Binding ActualWidth, ElementName=SelectChrome}">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectChrome" Property="BorderBrush" Value="#66849C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectChrome" Property="BorderBrush" Value="#59BDB1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#B9CCD9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InvisibleScrollRepeat" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#42566A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" CornerRadius="5" Margin="2,1"
                                Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#68819B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#6BAEAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalSoftScroll" TargetType="ScrollBar">
            <Border Width="10" Background="#182431" CornerRadius="5">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeat}"
                                      Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SoftScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeat}"
                                      Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalSoftScroll" TargetType="ScrollBar">
            <Border Height="10" Background="#182431" CornerRadius="5">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeat}"
                                      Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SoftScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeat}"
                                      Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template" Value="{StaticResource VerticalSoftScroll}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalSoftScroll}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="7"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#456175"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnemyRoleExtras" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PickTileTemplate">
            <StackPanel Margin="3,0" ToolTip="{Binding TileHint}">
                <Button Height="65" Tag="{Binding}" Click="PickHero_Click"
                        Padding="0" Background="#1D3141">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Border Background="#192734" CornerRadius="6"
                                BorderThickness="1" BorderBrush="#375469"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SelectedHero.PortraitUrl}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="+" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="26"
                                           Foreground="#5B8593">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHero}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border VerticalAlignment="Bottom"
                                        Background="#CB101A24" Padding="1,3">
                                    <TextBlock Text="{Binding SelectedHero.Name}"
                                               Foreground="#ECF4FA" FontSize="10" FontWeight="SemiBold"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
                <TextBlock Text="{Binding PreviewText}"
                           TextAlignment="Center" FontSize="8" Foreground="#DCC08C"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Style="{StaticResource EnemyRoleExtras}" Margin="0,3,0,0">
                    <ComboBox FontSize="10" Padding="2,2" MinHeight="24"
                              Margin="0,0,0,1" Height="27"
                              ItemsSource="{Binding DataContext.EnemyPositionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Label" SelectedValuePath="Position"
                              SelectedValue="{Binding EnemyPosition, Mode=TwoWay}"/>
                    <CheckBox Content="На линии" FontSize="10"
                              IsChecked="{Binding IsLaneOpponent, Mode=TwoWay}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BanTileTemplate">
            <Button Width="45" Height="38" Margin="2" Padding="0"
                    Background="#263343" Tag="{Binding}" Click="PickBan_Click"
                    ToolTip="Нажми, чтобы выбрать или изменить забаненного героя">
                <Grid>
                    <Border Background="#172431" BorderBrush="#3A4B59"
                            BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding SelectedHero.PortraitUrl}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="+" FontSize="19" Foreground="#678294"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHero}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Line X1="2" Y1="36" X2="43" Y2="2"
                                  Stroke="#EE617B" StrokeThickness="2">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHero}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="67"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#192431" BorderBrush="#314252"
                BorderThickness="0,0,0,1" Padding="15,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="↻ Пересчитать (F5)"
                        Click="Refresh_Click" Width="147" Background="#356C5D"
                        Margin="0,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="DOTA HELPER" FontSize="21" FontWeight="Bold"
                               Foreground="#E0B76F"/>
                    <DockPanel>
                        <TextBlock Text="DRAFT ASSISTANT · 0.11" FontSize="10"
                                   Foreground="#9AAEBF" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding PatchDisplay}" FontSize="10"
                                   Foreground="#80CDB7"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="10,11,10,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" MinWidth="200" MaxWidth="315"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="510" MinWidth="420"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="410"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>
            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>

            <!-- Settings -->
            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="#34475B" BorderThickness="1" CornerRadius="12"
                    Padding="12" Margin="0,0,3,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="НАСТРОЙКИ" FontWeight="Bold"
                                   FontSize="14" Foreground="#E0B76F" Margin="0,0,0,9"/>
                        <TextBlock Text="ПОЗИЦИЯ" Foreground="#9EB0C0" FontSize="11"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding Positions}"
                                  SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"/>
                        <TextBlock Text="ИСТОЧНИК МЕТЫ" Foreground="#9EB0C0"
                                   FontSize="11" Margin="0,9,0,0"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding MetaOptions}"
                                  SelectedItem="{Binding SelectedMeta, Mode=TwoWay}"/>
                        <TextBlock Text="РАНГ" Foreground="#9EB0C0"
                                   FontSize="11" Margin="0,9,0,0"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding RankOptions}"
                                  SelectedItem="{Binding SelectedRank, Mode=TwoWay}"/>
                        <TextBlock Text="ПУЛ ГЕРОЕВ" Foreground="#9EB0C0"
                                   FontSize="11" Margin="0,9,0,0"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding PoolOptions}"
                                  SelectedItem="{Binding SelectedPool, Mode=TwoWay}"/>
                        <Border Height="1" Background="#304659" Margin="0,10,0,11"/>
                        <TextBlock Text="ТИП ДРАФТА" Foreground="#9EB0C0" FontSize="11"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding DraftModes}"
                                  SelectedItem="{Binding SelectedDraftMode, Mode=TwoWay}"/>
                        <TextBlock Text="МОЯ КОМАНДА" Foreground="#9EB0C0"
                                   FontSize="11" Margin="0,9,0,0"/>
                        <ComboBox IsEditable="False" ItemsSource="{Binding TeamSides}"
                                  SelectedItem="{Binding SelectedSide, Mode=TwoWay}"/>
                        <TextBlock Text="Ранг влияет на статистику, а не на число банов."
                                   Foreground="#7790A3" FontSize="10" Margin="0,7,0,6"
                                   TextWrapping="Wrap"/>
                        <Border Background="#182F36" BorderBrush="#3B6F69"
                                BorderThickness="1" CornerRadius="9"
                                Padding="8" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="АВТОМАТИЧЕСКИЙ ДРАФТ"
                                           Foreground="#76D0BF" FontSize="11"
                                           FontWeight="Bold" Margin="0,0,0,6"/>
                                <Button x:Name="GsiButton" Content="Подключить Dota 2"
                                        Background="#326F61" FontSize="12"
                                        Click="ConnectGsi_Click"/>
                                <TextBlock Text="{Binding GsiStatus}" Foreground="#A8C4C9"
                                           FontSize="10" TextWrapping="Wrap"
                                           Margin="0,7,0,0"
                                           ToolTip="GSI может не передавать все пики в All Pick. Программа не угадывает скрытых героев."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#222839" BorderBrush="#5A537A"
                                BorderThickness="1" CornerRadius="9"
                                Padding="8" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="ЭКРАННЫЙ ALL PICK"
                                           Foreground="#C5B3F5" FontSize="11"
                                           FontWeight="Bold" Margin="0,0,0,6"/>
                                <Button Content="Настроить области экрана"
                                        Click="CalibrateScreen_Click"
                                        Background="#4C456E" FontSize="11"/>
                                <Button x:Name="ScreenStartButton"
                                        Content="Начать сканирование"
                                        Click="ToggleScreen_Click"
                                        Background="#4E5574" FontSize="11"
                                        Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ScreenStatus}"
                                           Foreground="#B8C3DE" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                                <TextBlock Text="Эксперимент: распознаются только видимые портреты и красные перечёркивания. Неуверенные результаты игнорируются."
                                           Foreground="#8896B6" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="STEAM-ПРОФИЛЬ И API" IsExpanded="False"
                                  Foreground="#DDBD82" Margin="0,15,0,5">
                            <StackPanel Margin="0,10,0,4">
                                <TextBox Text="{Binding PlayerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="35" ToolTip="Steam Account ID, SteamID64 или URL"/>
                                <Button Content="Определить ранг" Click="LoadProfile_Click"
                                        Background="#35556F" Margin="0,5,0,4"/>
                                <TextBlock Text="{Binding ProfileSummary}"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="#99B0C1"/>
                                <Button Content="Проверить STRATZ API"
                                        Click="CheckStratz_Click" Background="#35556F"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="СПРАВКА И ОГРАНИЧЕНИЯ" IsExpanded="False"
                                  Foreground="#DDBD82" Margin="0,8,0,0">
                            <TextBlock Text="Пики Radiant/Dire. Баны All Pick общие для матча; в Captains Mode — семь на сторону. GSI сообщает только доступные Dota 2 данные: в обычном All Pick чужие пики могут отсутствовать. Ручной выбор остаётся доступен. CTR/WR из STRATZ не фильтруются строго по актуальному патчу. Условный балл не является вероятностью победы."
                                       TextWrapping="Wrap" Foreground="#9AAFBF"
                                       FontSize="11" Margin="0,9,0,0"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Visual draft -->
            <Border Grid.Column="2" Background="{StaticResource Panel}"
                    BorderBrush="#34475B" BorderThickness="1" CornerRadius="12"
                    Padding="12" Margin="3,0,3,0">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <Button DockPanel.Dock="Right" Content="Очистить драфт"
                                Background="#5A3745" Click="ClearDraft_Click"
                                Padding="10,5" FontSize="11"/>
                        <TextBlock Text="ДРАФТ" Foreground="#E0B76F"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="#102B2D" BorderBrush="#236E61"
                                    BorderThickness="1" CornerRadius="9" Padding="9"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding RadiantSideLabel}"
                                                   Foreground="#8BBEAA" FontSize="11"/>
                                        <TextBlock Text="◆ RADIANT" Foreground="#47D0B3"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding RadiantSlots}"
                                                  ItemTemplate="{StaticResource PickTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding IsCaptainsMode, Converter={StaticResource BoolVisible}}"
                                                Margin="0,11,0,0">
                                        <TextBlock Text="БАНЫ · 7" Foreground="#99BBAF"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding RadiantCaptainBans}"
                                                      ItemTemplate="{StaticResource BanTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="#2D1725" BorderBrush="#74304A"
                                    BorderThickness="1" CornerRadius="9" Padding="9"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding DireSideLabel}"
                                                   Foreground="#D29AAA" FontSize="11"/>
                                        <TextBlock Text="◆ DIRE" Foreground="#F27E94"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding DireSlots}"
                                                  ItemTemplate="{StaticResource PickTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding IsCaptainsMode, Converter={StaticResource BoolVisible}}"
                                                Margin="0,11,0,0">
                                        <TextBlock Text="БАНЫ · 7" Foreground="#DCA3B0"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding DireCaptainBans}"
                                                      ItemTemplate="{StaticResource BanTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E2A37" BorderBrush="#37495B"
                                    BorderThickness="1" CornerRadius="9" Padding="10"
                                    Visibility="{Binding IsAllPick, Converter={StaticResource BoolVisible}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <Button DockPanel.Dock="Right" Content="Сбросить баны"
                                                Click="ClearBans_Click" Background="#4F3943"
                                                FontSize="10" Padding="7,4"/>
                                        <TextBlock Text="БАНЫ МАТЧА · ALL PICK"
                                                   Foreground="#D8ADB8" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="Общие для обеих сторон. До 18 ячеек ручного ввода, не четыре персональных предпочтения."
                                               Foreground="#8EA5B9" TextWrapping="Wrap" FontSize="10"
                                               Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding AllPickBans}"
                                                  ItemTemplate="{StaticResource BanTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Нажми на портрет или +, чтобы выбрать героя. На слот «Твой пик» выводится выбранная рекомендация."
                                       Foreground="#90A5B5" TextWrapping="Wrap"
                                       FontSize="10" Margin="3,11,3,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Recommendations -->
            <Border Grid.Column="4" Background="{StaticResource Panel}"
                    CornerRadius="12" Padding="14" Margin="4,0,0,0" BorderBrush="#35485B" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="УСЛОВНЫЙ БАЛЛ 0–100"
                                       Foreground="#94A6B8" FontSize="10"
                                       VerticalAlignment="Center"
                                       ToolTip="Не вероятность победы"/>
                            <TextBlock Text="РЕКОМЕНДАЦИИ" FontSize="17"
                                       FontWeight="Bold" Foreground="#D9B36F"/>
                        </DockPanel>
                        <Grid Margin="0,8,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding HeroSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#2A3442" Foreground="White" CaretBrush="White"
                                     BorderBrush="#46596C" Padding="8,6"
                                     FontSize="13" MinHeight="33"
                                     ToolTip="Поиск героя по имени, например Dark Willow"/>
                            <Button Grid.Column="1" Content="×" Click="ClearSearch_Click"
                                    Background="#314355" Padding="0"
                                    Margin="4,0,0,0" FontSize="17"
                                    ToolTip="Сбросить поиск"/>
                        </Grid>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="★ Избранное"
                                    Click="ToggleFavorite_Click" Background="#564A37"
                                    FontSize="11" Padding="8,4" Margin="8,0,0,0"
                                    ToolTip="Добавить или убрать выбранного героя из избранного"/>
                            <TextBlock Text="{Binding ResultsLabel}" Foreground="#9BAFBE"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                    <Expander DockPanel.Dock="Bottom" Header="Разбор выбранного героя · нажми, чтобы раскрыть" IsExpanded="False"
                              Foreground="#E5EAF2" Background="#253041"
                              BorderBrush="#334355" BorderThickness="1"
                              Margin="0,8,0,0" Padding="6">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedRecommendation}"
                                        Margin="6,6,6,3">
                                <TextBlock Text="{Binding Hero.Name}" FontWeight="Bold"
                                           FontSize="16" Foreground="#D9B36F"/>
                                <TextBlock Text="{Binding PositionLabel}"
                                           FontSize="11" Foreground="#C4D1DE"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MetaLabel}"
                                           FontSize="12" Foreground="#9EE2BE"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding PopularityLabel}"
                                           FontSize="11" Foreground="#B9C8D8"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding EvidenceLabel}"
                                           FontSize="11" Foreground="#B9C8D8"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ReliabilityLabel}"
                                           FontSize="11" Foreground="#E2C28A"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding CounterpickSummary}"
                                           FontSize="11" Foreground="#A6D4EB"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SynergySummary}"
                                           FontSize="11" Foreground="#9CD9BA"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ScoreBreakdown}"
                                           FontSize="11" Foreground="#E2C28A"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Explanation}"
                                           FontSize="11" Foreground="#A9B5C3"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                    <ListView x:Name="RecommendationsList"
                              ItemsSource="{Binding VisibleRecommendations}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}"
                              Background="Transparent" Foreground="#E5EAF2"
                              BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="#243246"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2E455C"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#335E60"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Real Dota 2 artwork from Steam CDN; no generated images. -->
                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                        CornerRadius="10" Padding="7" BorderBrush="#384A5D" BorderThickness="1">
                                    <Grid Height="70">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="59"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="80" Height="45"
                                                Background="#14202D" CornerRadius="3"
                                                ClipToBounds="True" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="DOTA" Foreground="#46586B"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <Image Source="{Binding Hero.PortraitUrl}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="3,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RankLabel}"
                                                           Foreground="#A4B4C5" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Hero.Name}"
                                                           Foreground="#E5EAF2" FontWeight="SemiBold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FavoriteMark}"
                                                           Foreground="#D9B36F" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CompactRole}"
                                                           Foreground="#D4B889" FontSize="10"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding CompactWinRate}"
                                                           Foreground="#91D7B0" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding CompactCounterpick}"
                                                           Foreground="#B4CBE0" FontSize="10"
                                                           Margin="0,0,9,0"/>
                                                <TextBlock Text="{Binding CompactSynergy}"
                                                           Foreground="#9CD9BA" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ScoreLabel}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#D9B36F"
                                                       TextAlignment="Right"/>
                                            <TextBlock Text="баллов" Foreground="#99A9B8"
                                                       FontSize="10" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

        </Grid>
        <Border Grid.Row="2" Background="#172330" BorderBrush="#314353"
                BorderThickness="0,1,0,0" Padding="14,10">
            <TextBlock Text="{Binding Status}" Foreground="#A1B8C8"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>