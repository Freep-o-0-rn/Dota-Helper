<Window x:Class="DotaHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota Helper — Draft Assistant 0.6.1" Height="830" Width="1420"
        MinWidth="1120" MinHeight="670"
        Background="#10141D" Foreground="#E5EAF2"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1B2330"/>
        <SolidColorBrush x:Key="Muted" Color="#A2ADBC"/>
        <!-- Original hero artwork from Steam CDN, shared by both draft dropdowns. -->
        <DataTemplate x:Key="HeroItemTemplate">
            <StackPanel Orientation="Horizontal" Height="31">
                <Border Width="50" Height="28" Background="#1B2330"
                        CornerRadius="2" ClipToBounds="True" Margin="0,0,9,0">
                    <Grid>
                        <TextBlock Text="DOTA" Foreground="#8898A9" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding PortraitUrl}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="#17202C" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A3442"/>
            <Setter Property="Foreground" Value="#17202C"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34465A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFD9E6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1B2330" BorderBrush="#303D4F"
                BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="135" Content="↻ Пересчитать"
                        Click="Refresh_Click" Background="#536A46"/>
                <StackPanel>
                    <TextBlock Text="DOTA HELPER" FontSize="23" FontWeight="Bold"
                               Foreground="#D9B36F"/>
                    <TextBlock Text="DRAFT ASSISTANT • ПРОТОТИП 0.6.1"
                               FontSize="11" Foreground="#A2ADBC"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="455"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ТВОЯ ПОЗИЦИЯ" FontWeight="Bold"
                               Foreground="#D9B36F" FontSize="14"/>
                    <TextBlock Text="Выбери роль на этот матч" Margin="0,8,0,6"
                               Foreground="#A2ADBC" TextWrapping="Wrap"/>
                    <ComboBox IsEditable="False" ItemsSource="{Binding Positions}"
                              SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"/>
                    <TextBlock Text="ИСТОЧНИК МЕТЫ" FontWeight="Bold"
                               Foreground="#D9B36F" Margin="0,12,0,4"/>
                    <ComboBox IsEditable="False" ItemsSource="{Binding MetaOptions}"
                              SelectedItem="{Binding SelectedMeta, Mode=TwoWay}"/>
                    <TextBlock Text="МОЙ STEAM ПРОФИЛЬ" FontWeight="Bold"
                               Foreground="#D9B36F" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding PlayerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#2A3442" Foreground="White" CaretBrush="White"
                             BorderBrush="#46596C" MinHeight="30" Padding="5,5"
                             ToolTip="Steam Account ID, SteamID64 или ссылка вида steamcommunity.com/profiles/..."
                             />
                    <Button Content="Определить ранг по профилю" Click="LoadProfile_Click"
                            Margin="0,5,0,4" Background="#3C566F" FontSize="12"/>
                    <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap"
                               Foreground="#A2ADBC" FontSize="11"/>
                    <TextBlock Text="РАНГ (МОЖНО ВЫБРАТЬ ВРУЧНУЮ)" FontWeight="Bold"
                               Foreground="#D9B36F" Margin="0,12,0,4"/>
                    <ComboBox IsEditable="False" ItemsSource="{Binding RankOptions}"
                              SelectedItem="{Binding SelectedRank, Mode=TwoWay}"/>
                    <TextBlock Text="ПУЛ ГЕРОЕВ" FontWeight="Bold"
                               Foreground="#D9B36F" Margin="0,17,0,4"/>
                    <ComboBox IsEditable="False" ItemsSource="{Binding PoolOptions}"
                              SelectedItem="{Binding SelectedPool, Mode=TwoWay}"/>
                    <Button Content="Проверить STRATZ API" Click="CheckStratz_Click"
                            ToolTip="Проверяет авторизацию минимальным запросом и показывает HTTP-код, не раскрывая токен"
                            Background="#395A72" Margin="0,4,0,3" FontSize="12"/>
                    <TextBlock Text="«По ролям»: реальные позиции STRATZ. Нужен токен STRATZ_API_TOKEN. Эксперимент показывает всех."
                               Foreground="#A2ADBC" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>

                    <Border BorderBrush="#334053" BorderThickness="0,1,0,0"
                            Margin="0,17,0,17"/>
                    <TextBlock Text="КАК ПОЛЬЗОВАТЬСЯ" FontWeight="Bold"
                               Foreground="#D9B36F"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="#C9D1DB" LineHeight="22"
                               Text="1. Укажи профиль или ранг.&#10;2. Выбери свою позицию.&#10;3. Укажи врагов и их роли.&#10;4. Отметь противников на линии.&#10;5. Сравни контрпики по всему драфту."/>
                    <Border BorderBrush="#334053" BorderThickness="0,1,0,0"
                            Margin="0,17,0,17"/>
                    <TextBlock Text="ОГРАНИЧЕНИЯ" FontWeight="Bold"
                               Foreground="#D9B36F"/>
                    <TextBlock Text="Позиции — реальные матчи STRATZ. Контрпики STRATZ по рейтинговой группе, OpenDota — резерв. Данные пока не фильтруются по текущему патчу."
                               Foreground="#A2ADBC" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}"
                    CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ДРАФТ СОЮЗНИКОВ" FontSize="17"
                                   FontWeight="Bold" Foreground="#86C5A2"/>
                        <TextBlock Text="Твой герой ещё не выбран; добавь до 4 союзников."
                                   Foreground="#A2ADBC" Margin="0,5,0,10"
                                   TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Allies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="40" Height="28"
                                                Background="#14202D" ClipToBounds="True"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Image Source="{Binding SelectedHero.PortraitUrl}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.Heroes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemTemplate="{StaticResource HeroItemTemplate}"
                                                  TextSearch.TextPath="Name"
                                                  SelectedItem="{Binding SelectedHero, Mode=TwoWay}"/>
                                        <Button Grid.Column="3" Content="×" Margin="4,5,0,5"
                                                ToolTip="Очистить" Padding="0"
                                                Tag="{Binding}" Click="ClearSlot_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="#334053" BorderThickness="0,1,0,0"
                                Margin="0,13,0,15"/>
                        <TextBlock Text="ДРАФТ ПРОТИВНИКОВ" FontSize="17"
                                   FontWeight="Bold" Foreground="#DA8989"/>
                        <TextBlock Text="Контрпики учитывают всех врагов. Укажи их роли: позиции 1–3 имеют приоритет."
                                   Foreground="#A2ADBC" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <ItemsControl ItemsSource="{Binding Enemies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="40" Height="28"
                                                    Background="#14202D" ClipToBounds="True"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image Source="{Binding SelectedHero.PortraitUrl}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.Heroes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource HeroItemTemplate}"
                                                      TextSearch.TextPath="Name"
                                                      SelectedItem="{Binding SelectedHero, Mode=TwoWay}"/>
                                            <Button Grid.Column="3" Content="×" Margin="4,5,0,5"
                                                    ToolTip="Очистить" Padding="0"
                                                    Tag="{Binding}" Click="ClearSlot_Click"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="87,0,0,0">
                                            <ComboBox IsEditable="False" Width="157" MinHeight="26"
                                                      FontSize="11" Margin="0,1,8,2"
                                                      ItemsSource="{Binding DataContext.EnemyPositionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Position"
                                                      SelectedValue="{Binding EnemyPosition, Mode=TwoWay}"/>
                                            <CheckBox Content="На моей линии"
                                                      IsChecked="{Binding IsLaneOpponent, Mode=TwoWay}"
                                                      FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}"
                    CornerRadius="10" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="РЕКОМЕНДАЦИИ" FontSize="17"
                                   FontWeight="Bold" Foreground="#D9B36F"/>
                        <TextBlock Text="0–100: условная оценка, НЕ вероятность победы."
                                   Foreground="#A2ADBC" TextWrapping="Wrap"
                                   Margin="0,5,0,10"/>
                        <TextBlock Text="ПОИСК ПО РЕКОМЕНДАЦИЯМ" Foreground="#A2ADBC" FontSize="11"/>
                        <TextBox Text="{Binding HeroSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2A3442" Foreground="White" CaretBrush="White"
                                 BorderBrush="#46596C" BorderThickness="1"
                                 Padding="9,7" FontSize="14" MinHeight="34"
                                 ToolTip="Начни вводить имя героя на английском, например Dark Willow"
                                 Margin="0,5,0,4"/>
                        <TextBlock Text="{Binding ResultsLabel}" Foreground="#A2ADBC"
                                   FontSize="11" Margin="0,0,0,9"/>
                        <Button Content="★ Добавить / убрать из избранного"
                                Click="ToggleFavorite_Click"
                                HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                Background="#564A37"/>
                    </StackPanel>
                    <Expander DockPanel.Dock="Bottom" Header="Подробности выбранного героя"
                              Foreground="#E5EAF2" Background="#253041"
                              BorderBrush="#334355" BorderThickness="1"
                              Margin="0,8,0,0" Padding="6">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedRecommendation}"
                                        Margin="6,6,6,3">
                                <TextBlock Text="{Binding Hero.Name}" FontWeight="Bold"
                                           FontSize="16" Foreground="#D9B36F"/>
                                <TextBlock Text="{Binding PositionLabel}"
                                           FontSize="11" Foreground="#C4D1DE"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MetaLabel}"
                                           FontSize="12" Foreground="#9EE2BE"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding PopularityLabel}"
                                           FontSize="11" Foreground="#B9C8D8"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding EvidenceLabel}"
                                           FontSize="11" Foreground="#B9C8D8"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding CounterpickSummary}"
                                           FontSize="11" Foreground="#A6D4EB"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ScoreBreakdown}"
                                           FontSize="11" Foreground="#E2C28A"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Explanation}"
                                           FontSize="11" Foreground="#A9B5C3"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                    <ListView x:Name="RecommendationsList"
                              ItemsSource="{Binding VisibleRecommendations}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}"
                              Background="#1B2330" Foreground="#E5EAF2"
                              BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Real Dota 2 artwork from Steam CDN; no generated images. -->
                                <Border Background="#253041" CornerRadius="6"
                                        Padding="6" Margin="0,0,5,5">
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="59"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="80" Height="45"
                                                Background="#14202D" CornerRadius="3"
                                                ClipToBounds="True" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="DOTA" Foreground="#46586B"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <Image Source="{Binding Hero.PortraitUrl}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="3,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RankLabel}"
                                                           Foreground="#A4B4C5" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Hero.Name}"
                                                           Foreground="#E5EAF2" FontWeight="SemiBold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FavoriteMark}"
                                                           Foreground="#D9B36F" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CompactWinRate}"
                                                           Foreground="#91D7B0" FontSize="11"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CompactCounterpick}"
                                                           Foreground="#B4CBE0" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ScoreLabel}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#D9B36F"
                                                       TextAlignment="Right"/>
                                            <TextBlock Text="баллов" Foreground="#99A9B8"
                                                       FontSize="10" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#141B25"
                BorderBrush="#303D4F" BorderThickness="0,1,0,0"
                Padding="20,13">
            <TextBlock Text="{Binding Status}" Foreground="#A9B8C7"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
